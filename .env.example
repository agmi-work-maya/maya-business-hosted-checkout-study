# Maya Checkout keys (Maya Manager > Developers). Create Checkout uses the PUBLIC key,
# status lookups use the SECRET key. Use sandbox keys while testing.
MAYA_PUBLIC_KEY=pk-xxxx
MAYA_SECRET_KEY=sk-xxxx
# Sandbox: https://pg-sandbox.paymaya.com   Production: https://pg.maya.ph
MAYA_BASE_URL=https://pg-sandbox.paymaya.com
PORT=3000
# Public URL of this app, used for redirect URLs
APP_BASE_URL=http://localhost:3000
